DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=church_management

# JWT signing secret — generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotate this if it is ever exposed; doing so invalidates all existing tokens.
JWT_SECRET=change_me_to_a_long_random_secret

# Access token lifetime (minutes) and refresh token lifetime (days).
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Comma-separated list of browser origins allowed to call the API.
# Never use "*" when credentials are sent. Include your frontend domain(s).
CORS_ORIGINS=http://127.0.0.1:*,http://localhost:*,https://yourdomain.com

# Web app server
WEB_HOST=0.0.0.0
WEB_PORT=8080

